bbcode_enabled = true
text = "[i][b]To whoever this concerns"

[node name="2" type="Label" parent="chapter0_1/Content" unique_id=1874541353]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "I’m not sure why I'm writing this."
autowrap_mode = 3

[node name="3" type="Label" parent="chapter0_1/Content" unique_id=1753456589]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Maybe because talking about it doesn’t help."
autowrap_mode = 3

[node name="4" type="Label" parent="chapter0_1/Content" unique_id=1296840812]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "I’ve lost my whole world and everyone seems to be
busy with theirs,"
autowrap_mode = 3
autowrap_trim_flags = 0

[node name="5" type="Label" parent="chapter0_1/Content" unique_id=508526313]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "To even care…
It’s selfish, I know. I just wish I had the power to stop
time and breathe for a little."
autowrap_mode = 3

[node name="space" type="Label" parent="chapter0_1/Content" unique_id=673100589]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
autowrap_mode = 3

[node name="6" type="Label" parent="chapter0_1/Content" unique_id=1171101114]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "It all started when Lady Thalia woke me up in the dead
of night.
She’d been crying, I could tell."
autowrap_mode = 3

[node name="7" type="Label" parent="chapter0_1/Content" unique_id=1051954095]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Yet, she wouldn’t mutter a word as she forced me out
of my own home."
autowrap_mode = 3

[node name="8" type="Label" parent="chapter0_1/Content" unique_id=1391958594]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "She begged me to go,
To travel far away,"
autowrap_mode = 3

[node name="9" type="RichTextLabel" parent="chapter0_1/Content" unique_id=1204266414]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_font_sizes/normal_font_size = 15
bbcode_enabled = true
text = "And not to come back until I was ready to face [u][b]my[/b][/u] reality."
autowrap_mode = 0
