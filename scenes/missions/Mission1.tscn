theme_override_font_sizes/font_size = 32
text = "A gang of bandits have recently pillaged a village near the outskirts of town. A known group that steals mostly gold and silver. 

The terrified villagers described how violent and ruthless they were while looting their banks. Your knights remind you this village was known for corruption in the local government. 

Their gold will meet the same fate even with different hands. You meet a stowaway bandit that explains how they don’t steal from the innocent and they need it themselves to live."
horizontal_alignment = 1
autowrap_mode = 2

