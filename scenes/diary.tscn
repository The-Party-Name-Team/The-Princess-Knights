size_flags_vertical = 3
theme = SubResource("Theme_hmom6")
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "And not to come back until I was ready to face [u][b]my[/b][/u] reality."
autowrap_mode = 2

[node name="4" type="Label" parent="1/2/Content" unique_id=720800038]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "I kept asking her to tell me the truth. Again and again,"
autowrap_mode = 3

[node name="5" type="Label" parent="1/2/Content" unique_id=91968751]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "even when she tried to change the subject. "
autowrap_mode = 3

[node name="6" type="Label" parent="1/2/Content" unique_id=1551494338]
layout_mode = 2
theme = SubResource("Theme_08tmx")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "I think she eventually realized I wasn't going to let it go.
"
autowrap_mode = 3
autowrap_trim_flags = 0

[node name="7" type="Label" parent="1/2/Content" unique_id=414525488]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "She went quiet for a moment before finally giving in. "
autowrap_mode = 3

[node name="8" type="Label" parent="1/2/Content" unique_id=1519384161]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
