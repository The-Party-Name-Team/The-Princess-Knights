theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "
I’m not sure why I'm writing this."
autowrap_mode = 2

[node name="3" type="Label" parent="1/1/Content" unique_id=359409911]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Maybe because talking about it doesn’t help."
autowrap_mode = 2

[node name="4" type="Label" parent="1/1/Content" unique_id=391741685]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "I’ve lost my whole world and everyone seems to be busy with theirs,"
autowrap_mode = 2
autowrap_trim_flags = 0

[node name="5" type="Label" parent="1/1/Content" unique_id=1394661326]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "To even care…
It’s selfish, I know. I just wish I had the power to stop time and breathe for a little."
autowrap_mode = 2

[node name="6" type="Label" parent="1/1/Content" unique_id=1937394279]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
autowrap_mode = 2

[node name="7" type="Label" parent="1/1/Content" unique_id=1339450584]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "It all started when Lady Thalia woke me up in the dead of night.
She’d been crying, I could tell."
autowrap_mode = 2

[node name="8" type="Label" parent="1/1/Content" unique_id=634321822]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Yet, she wouldn’t mutter a word as she forced me out of my own home."
autowrap_mode = 2

[node name="9" type="Label" parent="1/1/Content" unique_id=1912164827]
layout_mode = 2
