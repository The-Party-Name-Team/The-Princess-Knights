[node name="2" type="Label" parent="2/1/Content" unique_id=880681377]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "For the longest time, I thought my parents would always guide me through everything."
autowrap_mode = 3

[node name="3" type="Label" parent="2/1/Content" unique_id=355745737]
layout_mode = 2
theme = ExtResource("4_3jv7o")
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "All our small memories…
